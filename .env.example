# Sanity CMS Konfigurace
PUBLIC_SANITY_PROJECT_ID="your-project-id"
PUBLIC_SANITY_DATASET="production"

# Veřejná URL webu (bez koncového lomítka)
PUBLIC_SITE_URL="http://localhost:4321"

# Zdroj obsahu: auto (dev), sanity (produkce), fallback (deterministické CI)
CONTENT_SOURCE="auto"

# Čtecí token pro náhled nepublikovaných konceptů (Viewer role v Sanity)
# Studio a ruční produkční deploy
PUBLIC_SANITY_STUDIO_TITLE="Záda bez bolesti CMS"
PUBLIC_GITHUB_ACTIONS_URL=""

# Statický kontaktní formulář (Web3Forms)
PUBLIC_WEB3FORMS_ACCESS_KEY=""

# Business analytika: plausible | umami | ga4 | none
PUBLIC_ANALYTICS_PROVIDER="none"
PUBLIC_PLAUSIBLE_DOMAIN=""
PUBLIC_PLAUSIBLE_SCRIPT_URL=""
PUBLIC_UMAMI_WEBSITE_ID=""
PUBLIC_UMAMI_SCRIPT_URL="https://cloud.umami.is/script.js"
PUBLIC_GA_MEASUREMENT_ID=""
PUBLIC_ANALYTICS_DEBUG="false"

# Technické RUM je oddělené od business analytiky
PUBLIC_RUM_PROVIDER="none"
PUBLIC_CLOUDFLARE_BEACON_TOKEN=""

# Release gate / health check
SMOKE_SITE_TITLE="Záda bez bolesti"
SMOKE_CRITICAL_PATH="/clanky/"
SMOKE_CRITICAL_TITLE="Články"
