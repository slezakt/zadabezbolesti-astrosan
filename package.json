{
  "name": "zadabezbolesti-redesign",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/generate-build-info.js",
    "preview": "astro preview",
    "typecheck": "astro check",
    "typegen": "sanity schema extract --path ./schema.json --force --enforce-required-fields && sanity typegen generate",
    "test:unit": "vitest run",
    "test:predeploy": "node scripts/smoke-test-predeploy.js",
    "test:postdeploy": "node scripts/smoke-test-postdeploy.js",
    "deploy:cloudflare": "wrangler deploy",
    "monitor": "node scripts/monitor-production.js",
    "verify": "npm run typegen && npm run test:unit && npm run typecheck && npm run build && npm run test:predeploy",
    "astro": "astro"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Astro + Sanity redesign projektu zadabezbolesti.cz.",
  "dependencies": {
    "@alpinejs/csp": "^3.16.1",
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@sanity/astro": "^3.5.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.16.1",
    "astro": "^7.2.2",
    "astro-portabletext": "^0.13.0",
    "groq": "^6.9.2",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.9.2",
    "sanity-plugin-media": "^6.1.3",
    "styled-components": "^6.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.2.3",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
