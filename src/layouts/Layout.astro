---
import SchemaOrg from '../components/SchemaOrg.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import type { StructuredDataProps } from '../domain/schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schemaType?: 'WebSite' | 'Organization' | 'Article' | 'LocalBusiness';
  schemaData?: StructuredDataProps;
  hideChrome?: boolean;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title = 'ZádaBezBolesti.cz – Zdravotní magazín a ergonomický nástroj',
  description = 'Bezpečný první krok při bolesti zad. Praktické návody, ergonomická kalkulačka a ověřené cviky pro lidi se sedavým zaměstnáním.',
  noindex = false,
  schemaType = 'WebSite',
  schemaData = {},
  hideChrome = false,
  faq,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM content summary" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Strukturovaná data Schema.org -->
    <SchemaOrg type={schemaType} title={title} description={description} faq={faq} {...schemaData} />

    <!-- Google Fonts: Fraunces & Hanken Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Hanken+Grotesk:ital,wght@0,300..800;1,300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F7F5EF] text-[#18211C] min-h-screen flex flex-col antialiased selection:bg-[#C9DCCF] selection:text-[#18211C]">
    <div class="flex flex-col min-h-screen">
      {!hideChrome && (
        <header class="sticky top-0 z-40 w-full bg-[#F7F5EF] border-b border-[#DDE5DD]">
          <div class="max-w-7xl mx-auto px-6 sm:px-8 h-20 flex items-center justify-between">
            <a href="/" class="group flex items-baseline gap-1.5 focus:outline-none" data-analytics-event="navigation_click" data-analytics-target-id="home" data-analytics-location="header">
              <span class="font-serif-editorial text-2xl font-bold tracking-tight text-[#18211C]">
                ZádaBezBolesti<span class="text-[#F2644B]">.cz</span>
              </span>
                <span class="hidden sm:inline-block text-[11px] uppercase tracking-wider text-[#66736A] font-medium border-l border-[#DDE5DD] pl-2.5 ml-1">
                  Zdravotní magazín
              </span>
            </a>

            <nav class="hidden lg:flex items-center gap-8 text-[15px] font-medium text-[#18211C]">
              <a href="/typy-bolesti/" class="hover:text-[#2F5941] link-underline">Bolesti zad</a>
              <a href="/cviky-na-zada/" class="hover:text-[#2F5941] link-underline">Cviky</a>
              <a href="/ergonomie-pracoviste/" class="hover:text-[#2F5941] link-underline">Ergonomie</a>
              <a href="/zdravy-spanek/" class="hover:text-[#2F5941] link-underline">Spánek</a>
              <a href="/nastroje/kalkulacka/" class="hover:text-[#2F5941] link-underline inline-flex items-center gap-1.5">
                Kalkulačka
              </a>
              <a href="/blog/" class="hover:text-[#2F5941] link-underline">Magazín</a>
            </nav>

            <div class="hidden sm:flex items-center gap-4">
              <a
                href="/#diagnostic"
                class="text-[14px] font-semibold text-[#173326] link-underline hover:text-[#F2644B]"
              >
                Rychlý rozcestník
              </a>
            </div>

            <details class="group lg:hidden relative">
              <summary class="p-2 -mr-2 text-xl text-[#18211C] cursor-pointer focus:outline-none" aria-label="Přepnout menu">
                <span class="group-open:hidden" aria-hidden="true">☰</span>
                <span class="hidden group-open:inline" aria-hidden="true">✕</span>
              </summary>

              <div class="fixed left-0 right-0 top-20 bg-[#F7F5EF] border-b border-[#DDE5DD] px-6 py-6">
                <nav class="max-w-7xl mx-auto flex flex-col text-[17px] font-medium text-[#18211C] divide-y divide-[#DDE5DD]">
                  <a href="/typy-bolesti/" class="py-3.5 hover:text-[#2F5941]">Bolesti zad</a>
                  <a href="/cviky-na-zada/" class="py-3.5 hover:text-[#2F5941]">Cviky na záda</a>
                  <a href="/ergonomie-pracoviste/" class="py-3.5 hover:text-[#2F5941]">Ergonomie pracoviště</a>
                  <a href="/zdravy-spanek/" class="py-3.5 hover:text-[#2F5941]">Zdravý spánek</a>
                  <a href="/nastroje/kalkulacka/" class="py-3.5 hover:text-[#2F5941]">Ergonomická kalkulačka</a>
                  <a href="/blog/" class="py-3.5 hover:text-[#2F5941]">Magazín a články</a>
                  <a href="/#diagnostic" class="py-3.5 font-semibold text-[#2F5941]">Rychlý rozcestník podle bolesti</a>
                </nav>
              </div>
            </details>
          </div>
        </header>
      )}

      <main class:list={[{ "flex-1 max-w-7xl w-full mx-auto px-6 py-10": !hideChrome, "flex-1 w-full": hideChrome }]}>
        <slot />
      </main>

      {!hideChrome && (
        <footer class="w-full bg-[#173326] border-t border-[#2F5941] py-14 text-[#F7F5EF] mt-auto">
          <div class="max-w-7xl mx-auto px-6 sm:px-8">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-[#2F5941]">
              <div class="md:col-span-5 flex flex-col">
                <span class="font-serif-editorial text-2xl font-bold tracking-tight text-[#F7F5EF] mb-3">
                  ZádaBezBolesti<span class="text-[#F2644B]">.cz</span>
                </span>
                <p class="text-[14px] leading-relaxed text-[#C9DCCF] max-w-sm mb-4">
                  Praktický zdravotní magazín pro lidi se sedavým zaměstnáním. Pomáhá s orientací, prevencí a bezpečnými prvními kroky při bolesti zad.
                </p>
                <div class="text-xs text-[#C9DCCF]/70">
                  Informace mají edukativní charakter a nenahrazují individuální vyšetření ani fyzioterapii.
                </div>
              </div>

              <div class="md:col-span-3 flex flex-col">
                <span class="text-xs uppercase tracking-widest font-semibold text-[#C9DCCF] mb-4">Sekce a témata</span>
                <ul class="space-y-2.5 text-[14px] text-[#C9DCCF]">
                  <li><a href="/typy-bolesti/" class="hover:text-white transition-colors link-underline">Bolesti zad a příčiny</a></li>
                  <li><a href="/cviky-na-zada/" class="hover:text-white transition-colors link-underline">Cviky a mobilita u stolu</a></li>
                  <li><a href="/ergonomie-pracoviste/" class="hover:text-white transition-colors link-underline">Ergonomie stolu a židle</a></li>
                  <li><a href="/zdravy-spanek/" class="hover:text-white transition-colors link-underline">Zdravý spánek a regenerace</a></li>
                  <li><a href="/blog/" class="hover:text-white transition-colors link-underline font-medium">Magazín a články</a></li>
                </ul>
              </div>

              <div class="md:col-span-4 flex flex-col">
                <span class="text-xs uppercase tracking-widest font-semibold text-[#C9DCCF] mb-4">Nástroje a bezpečí</span>
                <ul class="space-y-2.5 text-[14px] text-[#C9DCCF] mb-6">
                  <li><a href="/nastroje/kalkulacka/" class="hover:text-white transition-colors link-underline font-medium">Ergonomická kalkulačka (ISO)</a></li>
                  <li><a href="/rizikove-faktory/" class="text-[#F2644B] hover:text-white transition-colors link-underline font-medium">Varovné signály a kdy volat lékaře</a></li>
                </ul>
                <div class="bg-[#2F5941]/50 p-4 rounded-xl border border-[#2F5941] text-xs text-[#C9DCCF]/80 leading-relaxed">
                  <strong class="text-[#C9DCCF]">Upozornění:</strong> Informace na tomto webu mají výhradně edukativní charakter a v žádném případě nenahrazují odborné lékařské vyšetření ani individuální fyzioterapii. Akutní nesnesitelná bolest vyžaduje linku 155.
                </div>
              </div>
            </div>

            <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#C9DCCF]/60 gap-4">
              <div>
                © {new Date().getFullYear()} ZádaBezBolesti.cz. Všechna práva vyhrazena.
              </div>
              <div class="flex gap-3 text-[#C9DCCF]/60 text-xs">
                <a href="/llms.txt" target="_blank" class="hover:text-[#C9DCCF] transition-colors hover:underline">AEO (llms.txt)</a> •
                <a href="/rss.xml" target="_blank" class="hover:text-[#C9DCCF] transition-colors hover:underline">RSS Feed</a> •
                <a href="/sitemap-index.xml" target="_blank" class="hover:text-[#C9DCCF] transition-colors hover:underline">Sitemap</a>
              </div>
            </div>
          </div>
        </footer>
      )}
    </div>

    <Analytics />
    <ConsentBanner />
  </body>
</html>
