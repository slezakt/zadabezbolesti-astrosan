---
import Layout from '../../layouts/Layout.astro';
import SanityImage from '../../components/SanityImage.astro';
import { getAllPosts } from '../../utils/content';

const posts = await getAllPosts();
---

<Layout
  title="Články | Astro & Sanity CMS Šablona"
  description="Seznam publikovaných článků v redakčním systému Sanity"
>
  <div class="posts-page">
    <header class="page-header">
      <h1 class="page-title">Všechny Články</h1>
      <p class="page-description">Přehled nejnovějších příspěvků načítaných z databáze Sanity CMS</p>
    </header>

    {posts && posts.length > 0 ? (
      <div class="posts-grid">
        {posts.map((post) => (
          <article class="post-card">
            {post.mainImage && (
              <div class="post-image-wrap">
                <SanityImage image={post.mainImage} alt={post.title} />
              </div>
            )}
            <div class="post-content">
              <div class="post-meta">
                {post.publishedAt && (
                  <span class="post-date">
                    {new Date(post.publishedAt).toLocaleDateString('cs-CZ')}
                  </span>
                )}
                {post.author?.name && (
                  <span class="post-author">• {post.author.name}</span>
                )}
              </div>
              <h2 class="post-title">
                <a href={`/clanky/${post.slug}`}>{post.title}</a>
              </h2>
              {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Zatím nebyly publikovány žádné články.</p>
        <p>
          Přidejte první článek v <a href="/admin">administraci Sanity Studio (/admin)</a>.
        </p>
      </div>
    )}
  </div>
</Layout>

<style>
  .posts-page {
    padding: 1rem 0;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .post-image-wrap {
    height: 200px;
    overflow: hidden;
  }

  .post-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .post-title {
    font-size: 1.35rem;
    font-family: var(--font-heading);
    margin-bottom: 0.75rem;
  }

  .post-title a {
    color: #fff;
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--color-primary);
  }

  .post-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty-state a {
    color: var(--color-primary);
  }
</style>
