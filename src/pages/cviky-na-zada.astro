---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/template/Header';
import { Footer } from '../components/template/Footer';
import ContentSafetyNote from '../components/ContentSafetyNote.astro';

const faqItems = [
  {
    question: 'Jak často bych měl při sedavé práci cvičit?',
    answer: 'Začněte malou dávkou, kterou zvládnete pravidelně, třeba krátkou změnou polohy či chůzí během dne. Neexistuje jeden správný interval pro všechny; důležité je nesetrvávat dlouho v nepohodlí.'
  },
  {
    question: 'Můžu cvičit, když mám akutní bolest v bedrech?',
    answer: 'Bez vyšetření nelze říct, který pohyb je pro vás vhodný. Pokud nemáte varovné příznaky, můžete volit jemný pohyb nebo polohu, která obtíže nezhoršuje. Při ostré, sílící či vystřelující bolesti cvičení přerušte a poraďte se se zdravotníkem.'
  },
  {
    question: 'Proč mě bolí mezi lopatkami po cvičení?',
    answer: 'Může jít o přetížení, ale na dálku nelze určit příčinu. Snižte intenzitu nebo cvik vynechte; pokud se bolest opakuje, zhoršuje nebo se přidají jiné příznaky, vyhledejte odborné posouzení.'
  },
  {
    question: 'Které cviky jsou pro záda rizikové?',
    answer: 'Rizikový je zejména pohyb přes ostrou bolest, prudké švihy a cvik, po kterém se obtíže zřetelně zhoršují. Vhodnost konkrétního cviku závisí na člověku i jeho potížích.'
  }
];

const clusterArticles = [
  {
    title: '3minutový strečink v kanceláři přímo u stolu',
    href: '/blog/strecink-v-kancelari/',
    readTime: '3 min praxe',
    desc: 'Krátká sekvence pomalých pohybů na židli pro chvíle, kdy vám je příjemné se rozhýbat.'
  },
  {
    title: '7 jednoduchých cviků pro úlevu od bolesti zad',
    href: '/blog/7-jednoduchych-cviku-pro-ulevu-od-bolesti-zad/',
    readTime: '5 min praxe',
    desc: 'Základní šetrné pohyby, které můžete vyzkoušet doma bez náčiní, pokud vám jsou příjemné.'
  },
  {
    title: 'Cviky na krční páteř pro kancelářské pracovníky',
    href: '/blog/cviky-na-krcni-pater-pro-kancelarske-pracovniky/',
    readTime: '4 min praxe',
    desc: 'Jemné pohyby pro krk a ramena bez prudkých švihů a bez cvičení přes bolest.'
  },
  {
    title: 'Cviky na uvolnění bederní páteře',
    href: '/blog/cviky-na-uvolneni-bederni-patere/',
    readTime: '6 min praxe',
    desc: 'Pomalá sestava pro bedra a pánev, kterou můžete vyzkoušet, pokud obtíže nezhoršuje.'
  }
];
---

<Layout
  title="Cviky na záda: jednoduché sestavy pro úlevu a zdravou páteř | ZádaBezBolesti.cz"
  description="Šetrné pohybové tipy pro lidi u počítače. Vyberte si krátkou sestavu k židli nebo pomalé cvičení doma podle toho, co vám vyhovuje."
  faq={faqItems}
  hideChrome={true}
>
  <div class="min-h-screen bg-[#F7F5EF] text-[#18211C] flex flex-col font-sans selection:bg-[#C9DCCF] selection:text-[#173326]">
    <Header />
    
    <main class="flex-1">
      {/* Editorial Hero Header */}
      <section class="w-full pt-12 pb-16 border-b border-[#DDE5DD]">
        <div class="max-w-4xl mx-auto px-6 sm:px-8">
          
          <nav aria-label="Drobečková navigace" class="mb-6">
            <ol class="flex items-center gap-2 text-xs font-mono text-[#66736A]">
              <li><a href="/" class="hover:text-[#2F5941] underline underline-offset-2">Domů</a></li>
              <li aria-hidden="true">/</li>
              <li class="text-[#18211C] font-semibold" aria-current="page">Cviky na záda</li>
            </ol>
          </nav>

          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-[#2F5941]"></span>
            <span class="text-xs uppercase tracking-widest font-semibold text-[#2F5941]">
              Tematický pilíř • Šetrný pohyb a mobilita
            </span>
          </div>

          <h1 class="font-serif-editorial text-[36px] sm:text-[48px] lg:text-[54px] leading-[1.1] font-semibold text-[#18211C] tracking-tight mb-6">
            Cviky na záda: <br class="hidden sm:inline" />
            šetrné sestavy pro více pohybu během dne
          </h1>

          <p class="text-[18px] sm:text-[20px] leading-[1.6] text-[#66736A]">
            Neexistuje jeden cvik pro každá záda. Začněte pomalu, sledujte reakci těla a vybírejte pohyb, který nezhoršuje obtíže. Tento obsah nenahrazuje individuální posouzení.
          </p>

        </div>
      </section>

      <ContentSafetyNote context="Tyto sestavy jsou obecné pohybové tipy. Zvolte jen pohyb, který je vám příjemný, a nesnažte se bolest překonat silou." />

      {/* 3 Core Exercise Categories */}
      <section class="w-full py-16 sm:py-20 border-b border-[#DDE5DD]">
        <div class="max-w-4xl mx-auto px-6 sm:px-8">
          
          <h2 class="font-serif-editorial text-[28px] sm:text-[36px] font-semibold text-[#18211C] mb-4">
            Vyberte si sestavu podle situace
          </h2>
          <p class="text-[16px] text-[#66736A] leading-relaxed mb-8">
            Vyberte si krátkou a proveditelnou variantu podle toho, kde jste a kolik máte času. Pokud pohyb obtíže zhoršuje, přerušte ho.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
            
            <div class="bg-[#EAF4EE] rounded-2xl p-6 border border-[#C9DCCF] flex flex-col justify-between">
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-[#2F5941] block mb-2">3 minuty • Bez pomůcek</span>
                <h3 class="font-serif-editorial text-xl font-semibold text-[#18211C] mb-3">U pracovního stolu</h3>
                <p class="text-sm text-[#66736A] leading-relaxed mb-4">
                  Krátká změna polohy a pomalé pohyby přímo na kancelářské židli, bez převlékání a bez pomůcek.
                </p>
              </div>
              <a href="/blog/strecink-v-kancelari/" class="text-xs font-semibold text-[#2F5941] bg-[#F7F5EF] px-3 py-2 rounded-xl border border-[#DDE5DD] text-center hover:bg-white transition-colors">
                Spustit 3minutový set →
              </a>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-[#DDE5DD] flex flex-col justify-between">
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-[#66736A] block mb-2">7 minut • Podložka</span>
                <h3 class="font-serif-editorial text-xl font-semibold text-[#18211C] mb-3">Bedra a pánev</h3>
                <p class="text-sm text-[#66736A] leading-relaxed mb-4">
                  Pomalé pohyby v lehu pro dny, kdy je vám příjemné rozhýbat se mimo pracovní stůl.
                </p>
              </div>
              <a href="/blog/cviky-na-uvolneni-bederni-patere/" class="text-xs font-semibold text-[#18211C] bg-[#F7F5EF] px-3 py-2 rounded-xl border border-[#DDE5DD] text-center hover:bg-[#EAF4EE] transition-colors">
                Zobrazit cviky na bedra →
              </a>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-[#DDE5DD] flex flex-col justify-between">
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-[#66736A] block mb-2">5 minut • Sed či stoj</span>
                <h3 class="font-serif-editorial text-xl font-semibold text-[#18211C] mb-3">Krk a šíje</h3>
                <p class="text-sm text-[#66736A] leading-relaxed mb-4">
                  Jemné pohyby pro šíji a ramena bez kroužení hlavou v krajních polohách.
                </p>
              </div>
              <a href="/blog/cviky-na-krcni-pater-pro-kancelarske-pracovniky/" class="text-xs font-semibold text-[#18211C] bg-[#F7F5EF] px-3 py-2 rounded-xl border border-[#DDE5DD] text-center hover:bg-[#EAF4EE] transition-colors">
                Zobrazit cviky na krk →
              </a>
            </div>

          </div>

        </div>
      </section>

      {/* Cluster Articles */}
      <section class="w-full py-16 sm:py-20 bg-white border-b border-[#DDE5DD]">
        <div class="max-w-4xl mx-auto px-6 sm:px-8">
          
          <span class="text-xs uppercase tracking-widest font-semibold text-[#2F5941] block mb-2">
            Článkový klastr
          </span>
          <h2 class="font-serif-editorial text-[28px] sm:text-[36px] font-semibold text-[#18211C] mb-8">
            Další šetrné pohybové tipy
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {clusterArticles.map((article) => (
              <a
                href={article.href}
                class="editorial-card group p-6 rounded-2xl bg-[#F7F5EF] border border-[#DDE5DD] hover:border-[#2F5941] transition-all flex flex-col justify-between"
              >
                <div>
                  <span class="text-xs font-mono text-[#66736A] block mb-2">{article.readTime}</span>
                  <h3 class="font-serif-editorial text-xl font-semibold text-[#18211C] group-hover:text-[#2F5941] transition-colors mb-2">
                    {article.title}
                  </h3>
                  <p class="text-sm text-[#66736A] leading-relaxed mb-4">
                    {article.desc}
                  </p>
                </div>
                <span class="text-xs font-semibold text-[#2F5941] group-hover:text-[#F2644B] inline-flex items-center gap-1 link-underline">
                  Číst návod →
                </span>
              </a>
            ))}
          </div>

        </div>
      </section>

      {/* FAQ Section */}
      <section class="w-full py-16 sm:py-20 bg-[#F7F5EF] border-b border-[#DDE5DD]">
        <div class="max-w-4xl mx-auto px-6 sm:px-8">
          
          <h2 class="font-serif-editorial text-[28px] sm:text-[36px] font-semibold text-[#18211C] mb-8 text-center">
            Časté dotazy ke cvičení na záda
          </h2>

          <div class="space-y-4">
            {faqItems.map((item) => (
              <details class="faq-item group bg-white rounded-xl border border-[#DDE5DD] p-6 text-left">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-[#18211C] text-[17px] focus:outline-none">
                  <span>{item.question}</span>
                  <span class="faq-icon text-[#2F5941] font-bold text-xl transition-transform duration-200 group-open:rotate-45">+</span>
                </summary>
                <p class="mt-4 text-[#66736A] leading-relaxed text-[15px] border-t border-[#DDE5DD] pt-4">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>

        </div>
      </section>

      {/* Pillar Cross-links CTA */}
      <section class="w-full py-16 bg-[#173326] text-[#F7F5EF]">
        <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center">
          <h2 class="font-serif-editorial text-3xl font-bold mb-4">Máte odcvičeno? Zkontrolujte ergonomii stolu</h2>
          <p class="text-[#C9DCCF] mb-8 text-lg max-w-xl mx-auto">
            Nastavení židle a monitoru může zpříjemnit pracovní den, zejména když jej spojíte s pravidelnou změnou polohy a činnosti.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/ergonomie-pracoviste/" class="px-6 py-3.5 rounded-xl bg-[#F7F5EF] text-[#173326] font-semibold hover:bg-white transition-colors">
              Ergonomie pracoviště
            </a>
            <a href="/zdravy-spanek/" class="px-6 py-3.5 rounded-xl bg-[#2F5941] text-[#F7F5EF] font-semibold hover:bg-[#3d7053] transition-colors border border-[#C9DCCF]/30">
              Zdravý spánek
            </a>
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</Layout>
