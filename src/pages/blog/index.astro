---
import Layout from '../../layouts/Layout.astro';
import SanityImage from '../../components/SanityImage.astro';
import { getAllCategories, getAllPosts } from '../../utils/content';

const [allPostsList, categories] = await Promise.all([getAllPosts(), getAllCategories()]);
const posts = [...allPostsList].sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());
const featuredPost = posts[0];
const supportingPosts = posts.slice(1, 3);
const latestPosts = posts.slice(3);

const formatDate = (value?: string) => value
  ? new Date(value).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

function getTopicFallbackImage(slug: string, title: string): string {
  const s = `${slug} ${title}`.toLowerCase();
  if (s.includes('monitor') || s.includes('stul') || s.includes('stůl') || s.includes('ergonom') || s.includes('sedet') || s.includes('sedět') || s.includes('pocitac') || s.includes('počítač')) {
    return 'https://images.unsplash.com/photo-1593062096033-9a26b09da705?auto=format&fit=crop&w=1200&q=80';
  }
  if (s.includes('span') || s.includes('spán') || s.includes('matrac') || s.includes('polstar') || s.includes('polštář') || s.includes('noc')) {
    return 'https://images.unsplash.com/photo-1541781774459-bb2af2f05b55?auto=format&fit=crop&w=1200&q=80';
  }
  if (s.includes('cvik') || s.includes('strec') || s.includes('streč') || s.includes('uvolneni') || s.includes('uvolnění') || s.includes('pohyb')) {
    return 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=1200&q=80';
  }
  if (s.includes('krk') || s.includes('sij') || s.includes('šíj') || s.includes('trapez') || s.includes('trapéz') || s.includes('lopatk')) {
    return 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=1200&q=80';
  }
  if (s.includes('stres') || s.includes('psych') || s.includes('unav')) {
    return 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1200&q=80';
  }
  return 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1200&q=80';
}
---

<Layout
  title="Magazín a odborné návody pro zdravá záda | ZádaBezBolesti.cz"
  description="Přehled ověřených fyzioterapeutických návodů, ergonomických standardů a cviků pro prevenci i úlevu od bolesti zad."
>
  <div class="max-w-7xl mx-auto py-6 sm:py-10">
    <header class="mb-8 sm:mb-12">
      <p class="eyebrow mb-3">Nezávislý průvodce zdravými zády</p>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-12 items-end">
        <h1 class="lg:col-span-8 font-serif-editorial text-[44px] sm:text-6xl lg:text-[76px] font-semibold text-[#18211C] tracking-[-0.045em] leading-[0.98]">
          Magazín
        </h1>
        <p class="lg:col-span-4 text-[16px] text-[#66736A] leading-relaxed max-w-xl lg:pb-1">
          Praktické návody bez zbytečných slibů. Ergonomie, bezpečný pohyb, spánek a orientace v bolesti zad.
        </p>
      </div>

      {categories && categories.length > 0 && (
        <nav class="mt-8 pt-4 border-t border-[#18211C] flex flex-wrap gap-x-6 gap-y-3 text-[13px] font-semibold" aria-label="Rubriky magazínu">
          <a href="/blog/" class="text-[#18211C] underline decoration-[#F2644B] decoration-2 underline-offset-[6px]">
            Všechny články <span class="text-[#66736A]">({posts.length})</span>
          </a>
          {categories.map((cat) => (
            <a href={`/blog/kategorie/${cat.slug}/`} class="text-[#66736A] hover:text-[#18211C] hover:underline underline-offset-[6px]">
              {cat.title}
            </a>
          ))}
        </nav>
      )}
    </header>

    {featuredPost ? (
      <>
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 py-8 sm:py-10 border-y border-[#18211C]" aria-labelledby="featured-heading">
          <article class="lg:col-span-7 group">
            <a href={`/blog/${featuredPost.slug}/`} class="block aspect-[16/9] overflow-hidden bg-[#EAF4EE] mb-6 border border-[#DDE5DD]">
              {featuredPost.mainImage ? (
                <SanityImage image={featuredPost.mainImage} alt={featuredPost.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" />
              ) : (
                <img src={getTopicFallbackImage(featuredPost.slug, featuredPost.title)} alt={featuredPost.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" />
              )}
            </a>
            <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] font-semibold text-[#2F5941] mb-3">
              <span>{featuredPost.categories?.[0]?.title || 'Aktuálně'}</span>
              {featuredPost.publishedAt && <span class="text-[#66736A] normal-case tracking-normal font-normal">· {formatDate(featuredPost.publishedAt)}</span>}
            </div>
            <h2 id="featured-heading" class="font-serif-editorial text-[34px] sm:text-[46px] leading-[1.08] font-semibold tracking-[-0.025em] text-[#18211C] mb-4 group-hover:text-[#2F5941]">
              <a href={`/blog/${featuredPost.slug}/`}>{featuredPost.title}</a>
            </h2>
            {featuredPost.excerpt && <p class="text-[16px] sm:text-[17px] leading-relaxed text-[#66736A] max-w-2xl">{featuredPost.excerpt}</p>}
            {featuredPost.author?.name && <p class="mt-5 text-xs text-[#66736A]">Autor: <span class="text-[#18211C] font-medium">{featuredPost.author.name}</span></p>}
          </article>

          <div class="lg:col-span-5 lg:border-l lg:border-[#DDE5DD] lg:pl-10 flex flex-col divide-y divide-[#DDE5DD]">
            {supportingPosts.map((post, index) => (
              <article class:list={["group", { "pb-8": index === 0, "pt-8": index > 0 }]}>
                <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] font-semibold text-[#2F5941] mb-3">
                  <span>{post.categories?.[0]?.title || 'Magazín'}</span>
                  {post.publishedAt && <span class="text-[#66736A] normal-case tracking-normal font-normal">· {formatDate(post.publishedAt)}</span>}
                </div>
                <h2 class="font-serif-editorial text-[25px] sm:text-[29px] leading-[1.14] font-semibold text-[#18211C] group-hover:text-[#2F5941] mb-3">
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                </h2>
                {post.excerpt && <p class="text-[14px] leading-relaxed text-[#66736A] line-clamp-3">{post.excerpt}</p>}
              </article>
            ))}
          </div>
        </section>

        {latestPosts.length > 0 && (
          <section class="pt-14 sm:pt-20" aria-labelledby="latest-heading">
            <div class="flex items-baseline justify-between gap-4 pb-4 border-b-2 border-[#18211C]">
              <h2 id="latest-heading" class="font-serif-editorial text-3xl sm:text-4xl font-semibold text-[#18211C]">Nejnovější články</h2>
              <span class="hidden sm:inline text-xs text-[#66736A]">{latestPosts.length} dalších textů</span>
            </div>

            <div class="divide-y divide-[#DDE5DD]">
              {latestPosts.map((post) => (
                <article class="group grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 py-7 sm:py-8">
                  <div class="md:col-span-2 text-xs text-[#66736A] pt-1">
                    {post.publishedAt && <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>}
                    <span class="block mt-1 uppercase tracking-wider font-semibold text-[#2F5941]">{post.categories?.[0]?.title || 'Magazín'}</span>
                  </div>
                  <div class="md:col-span-6">
                    <h3 class="font-serif-editorial text-[23px] sm:text-[27px] leading-[1.16] font-semibold text-[#18211C] group-hover:text-[#2F5941]">
                      <a href={`/blog/${post.slug}/`}>{post.title}</a>
                    </h3>
                  </div>
                  <div class="md:col-span-4 flex items-start gap-5">
                    {post.excerpt && <p class="text-[14px] leading-relaxed text-[#66736A] line-clamp-3 flex-1">{post.excerpt}</p>}
                    <a href={`/blog/${post.slug}/`} class="text-[#2F5941] group-hover:text-[#F2644B] text-lg" aria-label={`Číst: ${post.title}`}>↗</a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="text-center py-16 px-6 border-y border-[#DDE5DD]">
        <p class="text-lg font-serif-editorial font-semibold text-[#18211C] mb-2">Zatím nebyly publikovány žádné články.</p>
        <p class="text-sm text-[#66736A]">
          Přidejte první článek v <a href="/admin/" class="text-[#2F5941] underline">administraci Sanity Studio (/admin)</a>.
        </p>
      </div>
    )}
  </div>
</Layout>
