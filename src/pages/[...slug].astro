---
import Layout from '../layouts/Layout.astro';
import PortableText from '../components/PortableText/PortableText.astro';
import { fetchSanity } from '../utils/sanity';
import { pageQuery } from '../utils/queries';

export const prerender = false;

const { slug } = Astro.params;

// Pokud slug nebyl zadán, směrujeme na hlavní stranu
if (!slug) {
  return Astro.redirect('/');
}

const preview = Astro.cookies.has('sanity_draft_mode');

let page = null;
try {
  page = await fetchSanity(pageQuery, { slug }, { preview });
} catch (e) {
  page = null;
}

if (!page) {
  return Astro.redirect('/404');
}
---

<Layout
  title={page.seo?.metaTitle || page.title}
  description={page.seo?.metaDescription}
  preview={preview}
>
  <div class="dynamic-page">
    <header class="page-header">
      <h1 class="page-title">{page.title}</h1>
    </header>

    {page.content && (
      <div class="page-content">
        <PortableText value={page.content} />
      </div>
    )}
  </div>
</Layout>

<style>
  .dynamic-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    color: #fff;
  }

  .page-content {
    font-size: 1.1rem;
  }
</style>
