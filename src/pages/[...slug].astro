---
import Layout from '../layouts/Layout.astro';
import PortableText from '../components/PortableText/PortableText.astro';
import { getAllPages, getPage } from '../utils/content';

export async function getStaticPaths() {
  const dedicatedSlugs = new Set(['home', 'index', 'ergonomie-pracoviste', 'zdravy-spanek', 'bolest-krku-a-ramen', 'cviky-na-zada', 'typy-bolesti']);
  const pages = await getAllPages();
  return pages
    .filter((page) => !dedicatedSlugs.has(page.slug))
    .map((page) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/');
const page = await getPage(slug);

if (!page) {
  return new Response(null, { status: 404 });
}
---

<Layout
  title={page.seo?.metaTitle || `${page.title} | ZádaBezBolesti.cz`}
  description={page.seo?.metaDescription || `${page.title} – praktické informace pro pohodlnější práci, pohyb a spánek.`}
  noindex={page.seo?.noIndex}
>
  <article class="max-w-4xl mx-auto py-6">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-[#66736A] mb-8 font-medium" aria-label="Drobečková navigace">
      <a href="/" class="hover:text-[#2F5941] link-underline">Domů</a>
      <span>/</span>
      <span class="text-[#18211C]">{page.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#2F5941]"></span>
        <span class="text-xs uppercase tracking-widest font-semibold text-[#2F5941]">
          Informační průvodce
        </span>
      </div>
      <h1 class="font-serif-editorial text-3xl sm:text-4xl lg:text-5xl font-bold text-[#18211C] leading-[1.15] mb-4 tracking-tight">
        {page.title}
      </h1>
    </header>

    <!-- Content -->
    {page.content && page.content.length > 0 && (
      <div class="prose prose-stone max-w-none text-[#18211C] leading-relaxed space-y-6 text-[16.5px] pb-8">
        <PortableText value={page.content} />
      </div>
    )}

    {page.sources && page.sources.length > 0 && (
      <section class="my-10 border-t-2 border-[#173326] pt-8" aria-labelledby="sources-heading">
        <div class="inline-flex items-center gap-2 mb-2">
          <span class="w-2 h-2 bg-[#F2644B]"></span>
          <span class="text-xs uppercase tracking-widest font-semibold text-[#2F5941]">Redakční standard</span>
        </div>
        <h2 id="sources-heading" class="font-serif-editorial text-2xl sm:text-3xl font-bold text-[#18211C] mb-3">Zdroje</h2>
        <p class="text-sm leading-relaxed text-[#66736A] mb-5">Uvádíme doporučení a odborné podklady použité pro zdravotní a ergonomická tvrzení na této stránce.</p>
        <ul class="space-y-3">
          {page.sources.map((source) => (
            <li class="border border-[#DDE5DD] bg-[#F7F5EF] px-4 py-3">
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#173326] underline decoration-[#2F5941]/50 underline-offset-4 hover:text-[#2F5941]">
                {source.title}
              </a>
              {source.note && <p class="mt-1 text-sm leading-relaxed text-[#66736A]">Použito pro: {source.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <aside class="my-10 border-l-4 border-[#C94734] bg-[#FDF4F1] px-5 py-4 text-sm leading-relaxed text-[#18211C]">
      Tento obsah slouží k orientaci. Neurčuje příčinu bolesti ani nenahrazuje lékařské vyšetření nebo individuální doporučení fyzioterapeuta.
    </aside>

    <!-- FAQ section if available -->
    {page.faq && page.faq.length > 0 && (
      <section class="my-12 pt-8 border-t border-[#DDE5DD]">
        <h2 class="font-serif-editorial text-2xl sm:text-3xl font-bold text-[#18211C] mb-6">
          Často kladené otázky
        </h2>
        <div class="space-y-3">
          {page.faq.map((item) => (
            <details class="bg-[#F7F5EF] border border-[#DDE5DD] rounded-xl p-4 sm:p-5 group open:bg-[#EAF4EE]/40 transition-colors">
              <summary class="font-semibold text-[16px] text-[#18211C] cursor-pointer list-none flex items-center justify-between gap-4">
                <span>{item.question}</span>
                <span class="text-[#2F5941] text-xl transition-transform duration-200 group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-[14.5px] leading-relaxed text-[#66736A] pt-2 border-t border-[#DDE5DD]/60">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
