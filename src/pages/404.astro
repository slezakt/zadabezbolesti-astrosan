---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Stránka nenalezena (404) | ZádaBezBolesti.cz" noindex>
  <div class="text-center py-20 px-6 max-w-lg mx-auto">
    <div class="font-serif-editorial text-7xl sm:text-8xl font-bold text-[#F2644B] mb-4">
      404
    </div>
    <h1 class="font-serif-editorial text-3xl sm:text-4xl font-bold text-[#18211C] mb-4">
      Stránka nenalezena
    </h1>
    <p class="text-[16px] text-[#66736A] leading-relaxed mb-8">
      Požadovaná stránka neexistuje nebo byla přesunuta na jinou adresu.
    </p>
    <a
      href="/"
      class="btn-press inline-flex items-center justify-center px-6 py-3 rounded-xl bg-[#173326] text-[#F7F5EF] font-medium hover:bg-[#2F5941] transition-colors"
    >
      Zpět na hlavní stranu
    </a>
  </div>
</Layout>
