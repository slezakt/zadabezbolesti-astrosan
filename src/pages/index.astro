---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/template/Header';
import { HeroDiagnostic } from '../components/template/HeroDiagnostic';
import { QuickRelief } from '../components/template/QuickRelief';
import { ErgonomicCalculator } from '../components/template/ErgonomicCalculator';
import { MainGuides } from '../components/template/MainGuides';
import { TrustSection } from '../components/template/TrustSection';
import { PopularArticles } from '../components/template/PopularArticles';
import { FinalCta } from '../components/template/FinalCta';
import { Footer } from '../components/template/Footer';
import { getSiteSettings } from '../utils/content';

const siteSettings = await getSiteSettings();
---

<Layout
  title={siteSettings?.title || 'ZádaBezBolesti.cz – Zdravotní magazín a ergonomický nástroj'}
  description={siteSettings?.description || 'Bezpečný první krok při bolesti zad. Praktické návody, ergonomická kalkulačka a ověřené cviky pro lidi se sedavým zaměstnáním.'}
  hideChrome={true}
>
  <div class="min-h-screen bg-[#F7F5EF] text-[#18211C] flex flex-col font-sans selection:bg-[#C9DCCF] selection:text-[#173326]">
    <Header />
    <main class="flex-1">
      <HeroDiagnostic />
      <QuickRelief />
      <ErgonomicCalculator client:visible />
      <MainGuides />
      <TrustSection />
      <PopularArticles />
      <FinalCta />
    </main>
    <Footer />
  </div>
</Layout>
