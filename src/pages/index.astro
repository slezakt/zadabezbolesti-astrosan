---
import Layout from '../layouts/Layout.astro';
import SanityImage from '../components/SanityImage.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqAccordion from '../components/UI/FaqAccordion.astro';
import PricingTable from '../components/UI/PricingTable.astro';
import { fetchSanity } from '../utils/sanity';
import { allPostsQuery, siteSettingsQuery } from '../utils/queries';

export const prerender = false;

const preview = Astro.cookies.has('sanity_draft_mode');

let siteSettings = null;
let posts: any[] = [];
let fetchError = false;

try {
  siteSettings = await fetchSanity(siteSettingsQuery, {}, { preview });
  posts = await fetchSanity(allPostsQuery, {}, { preview });
} catch (e) {
  fetchError = true;
}
---

<Layout
  title={siteSettings?.title || 'Univerzální Astro 7 & Sanity CMS Šablona'}
  description={siteSettings?.description || 'Profesionální produkční šablona v češtině'}
  preview={preview}
  schemaType="LocalBusiness"
  schemaData={{
    telephone: '+420 123 456 789',
    priceRange: '$$',
    address: {
      streetAddress: 'Václavské náměstí 1',
      addressLocality: 'Praha 1',
      postalCode: '110 00',
      addressCountry: 'CZ',
    },
    geo: {
      latitude: 50.0813,
      longitude: 14.427,
    },
  }}
>
  <section class="text-center py-16 px-4 max-w-4xl mx-auto">
    <div class="inline-block bg-indigo-500/15 border border-indigo-500/30 text-indigo-400 px-4 py-1.5 rounded-full text-xs font-semibold mb-6">
      Astro 7 + Sanity CMS + Alpine.js + Tailwind v4 + AEO
    </div>

    <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-extrabold text-white leading-tight mb-6 bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">
      Univerzální Produkční Šablona pro Moderní Weby
    </h1>

    <p class="text-slate-400 text-lg sm:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
      Plně typově bezpečná architektura oddělující prezentační vrstvu Astro od strukturovaného obsahového modelu v Sanity CMS. Připraveno s podporou pro český jazyk, Visual Editing, Tailwind CSS v4, Multi-provider Analytiku, AEO (llms.txt) a reaktivní Alpine.js UI prvky.
    </p>

    <div class="flex justify-center gap-4 flex-wrap">
      <a
        href="/admin"
        target="_blank"
        class="bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold px-6 py-3.5 rounded-xl hover:opacity-95 transition shadow-[0_0_25px_rgba(99,102,241,0.3)]"
      >
        Otevřít Administraci CMS (/admin)
      </a>
      <a
        href="#kontakt"
        class="bg-slate-900/60 border border-white/10 text-white font-semibold px-6 py-3.5 rounded-xl hover:border-slate-500 transition"
      >
        Napsat Zprávu
      </a>
    </div>
  </section>

  {fetchError && (
    <div class="bg-amber-500/10 border border-amber-500/30 text-amber-300 p-6 rounded-2xl my-8">
      <h3 class="font-semibold text-lg mb-2">Upozornění k propojení se Sanity CMS</h3>
      <p class="text-sm text-amber-200/80 mb-2">
        Aplikace je připravena k načítání dat, avšak nebylo možné se připojit k Sanity API (nebo chybí platné <code>PUBLIC_SANITY_PROJECT_ID</code> v souboru <code>.env</code>).
      </p>
      <p class="text-sm">
        Pro propojení stačí v souboru <code>.env</code> vyplnit vaše <strong>Project ID</strong> a spustit administraci na adrese <a href="/admin" class="underline text-white">/admin</a>.
      </p>
    </div>
  )}

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 my-16">
    <div class="bg-slate-900/60 border border-white/10 rounded-2xl p-6 hover:border-indigo-500/50 transition">
      <div class="text-3xl mb-4">🚀</div>
      <h3 class="text-white font-heading font-semibold text-lg mb-2">Zero-JS & Tailwind v4</h3>
      <p class="text-slate-400 text-sm leading-relaxed">Vytvořeno pomocí nejnovějšího Tailwind CSS v4 engine a Alpine.js bez zbytečného balastu.</p>
    </div>

    <div class="bg-slate-900/60 border border-white/10 rounded-2xl p-6 hover:border-indigo-500/50 transition">
      <div class="text-3xl mb-4">🤖</div>
      <h3 class="text-white font-heading font-semibold text-lg mb-2">AEO & AI Vyhledávače</h3>
      <p class="text-slate-400 text-sm leading-relaxed">Připraveno pro AI agenty (Perplexity, ChatGPT, Claude) díky souboru <code>/llms.txt</code> a Schema.org LocalBusiness.</p>
    </div>

    <div class="bg-slate-900/60 border border-white/10 rounded-2xl p-6 hover:border-indigo-500/50 transition">
      <div class="text-3xl mb-4">📊</div>
      <h3 class="text-white font-heading font-semibold text-lg mb-2">Multi-provider Analytika</h3>
      <p class="text-slate-400 text-sm leading-relaxed">Integrace <code>@arraypress/analytics-astro</code> s GDPR lištou pro snadne přepínání GA4, Plausible či Umami.</p>
    </div>

    <div class="bg-slate-900/60 border border-white/10 rounded-2xl p-6 hover:border-indigo-500/50 transition">
      <div class="text-3xl mb-4">🛡️</div>
      <h3 class="text-white font-heading font-semibold text-lg mb-2">Bezpečný API Endpoint</h3>
      <p class="text-slate-400 text-sm leading-relaxed">Rate Limiting (max 3 e-maily/min), validace přes Zod, Honeypot a podpora pro Cloudflare Turnstile.</p>
    </div>
  </section>

  <section class="my-20">
    <h2 class="font-heading text-3xl font-bold text-white text-center mb-12">Ukázka Ceníkové Tabulky (Alpine.js)</h2>
    <PricingTable />
  </section>

  <section class="my-20">
    <h2 class="font-heading text-3xl font-bold text-white text-center mb-12">Často Kladené Dotazy (FAQ)</h2>
    <FaqAccordion />
  </section>

  <section id="kontakt" class="my-20">
    <h2 class="font-heading text-3xl font-bold text-white text-center mb-2">Napište Nám Zprávu</h2>
    <p class="text-slate-400 text-center mb-10">Ukázka zabezpečeného kontaktního formuláře s Rate Limitingem a Turnstile</p>
    <ContactForm />
  </section>

  {posts && posts.length > 0 && (
    <section class="my-20">
      <h2 class="font-heading text-3xl font-bold text-white mb-8">Nejnovější Články</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => (
          <article class="bg-slate-900/60 border border-white/10 rounded-2xl overflow-hidden flex flex-col">
            {post.mainImage && (
              <div class="h-48 overflow-hidden">
                <SanityImage image={post.mainImage} alt={post.title} />
              </div>
            )}
            <div class="p-5 flex flex-col flex-1">
              <span class="text-xs text-slate-400 mb-2">
                {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('cs-CZ') : ''}
              </span>
              <h3 class="text-lg font-heading font-semibold text-white mb-3">
                <a href={`/clanky/${post.slug}`} class="hover:text-indigo-400 transition">{post.title}</a>
              </h3>
              {post.excerpt && <p class="text-slate-400 text-sm leading-relaxed">{post.excerpt}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
