---
import { PortableText as PortableTextComponent } from 'astro-portabletext';
import SanityImage from '../SanityImage.astro';
import InternalLink from './InternalLink.astro';
import YouTubeEmbed from './YouTubeEmbed.astro';
import CalloutBox from './CalloutBox.astro';
import ExerciseCard from './ExerciseCard.astro';
import PositiveList from './PositiveList.astro';
import NegativeList from './NegativeList.astro';
import type { PageQueryResult, PostQueryResult } from '../../../sanity.types';
import type { SomePortableTextComponents } from 'astro-portabletext/types';

type PortableTextValue = NonNullable<NonNullable<PageQueryResult>['content']> | NonNullable<NonNullable<PostQueryResult>['body']>;

interface Props {
  value: PortableTextValue;
}

const { value } = Astro.props;

const components = {
  type: {
    image: SanityImage,
    youtube: YouTubeEmbed,
    calloutBox: CalloutBox,
    exerciseCard: ExerciseCard,
    positiveList: PositiveList,
    negativeList: NegativeList,
  },
  mark: {
    internalLink: InternalLink,
  },
} as unknown as SomePortableTextComponents;
---

<div class="portable-text">
  <PortableTextComponent value={value} components={components} />
</div>

<style is:global>
  .portable-text {
    line-height: 1.75;
    color: #18211C;
    font-size: 1.05rem;
  }

  .portable-text p {
    margin-bottom: 1.35rem;
  }

  .portable-text h2,
  .portable-text h3,
  .portable-text h4 {
    color: #18211C;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    line-height: 1.25;
  }

  .portable-text h2 {
    font-size: 1.85rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #DDE5DD;
  }

  .portable-text h3 {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .portable-text h4 {
    font-size: 1.15rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .portable-text blockquote {
    border-left: 3px solid #2F5941;
    background-color: #EAF4EE;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.15rem;
    color: #173326;
    border-radius: 0 0.75rem 0.75rem 0;
  }

  .portable-text ul,
  .portable-text ol {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
  }

  .portable-text ul {
    list-style-type: disc;
  }

  .portable-text ol {
    list-style-type: decimal;
  }

  .portable-text li {
    margin-bottom: 0.5rem;
  }
</style>
