---
interface Props {
  node: {
    title?: string;
    items?: string[];
  };
}

const { node } = Astro.props;
---

<div class="my-6 p-5 rounded-2xl bg-[#EAF4EE] border border-[#C9DCCF]">
  {node.title && (
    <div class="flex items-center gap-2 mb-3 text-[#173326] font-semibold text-base">
      <span class="text-[#2F5941] font-bold">✓</span>
      <span>{node.title}</span>
    </div>
  )}
  {node.items && node.items.length > 0 && (
    <ul class="space-y-2 text-[15px] text-[#18211C]/90">
      {node.items.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="text-[#2F5941] font-bold mt-0.5">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}
</div>
