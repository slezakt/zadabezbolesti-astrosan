---
import type { StructuredDataProps } from '../domain/schema';

interface Props {
  type?: 'WebSite' | 'Organization' | 'Article' | 'LocalBusiness';
  title?: string;
  description?: string;
  url?: string;
  image?: StructuredDataProps['image'];
  publishedAt?: StructuredDataProps['publishedAt'];
  authorName?: StructuredDataProps['authorName'];
  address?: StructuredDataProps['address'];
  geo?: StructuredDataProps['geo'];
  telephone?: StructuredDataProps['telephone'];
  priceRange?: StructuredDataProps['priceRange'];
  openingHours?: StructuredDataProps['openingHours'];
  faq?: Array<{ question: string; answer: string }>;
}

const {
  type = 'WebSite',
  title = 'Astro & Sanity CMS Šablona',
  description = 'Univerzální produkční šablona v češtině',
  url = Astro.url.href,
  image,
  publishedAt,
  authorName,
  address,
  geo,
  telephone,
  priceRange,
  openingHours,
  faq,
} = Astro.props;

let schemaData: Record<string, unknown> = {};

if (type === 'LocalBusiness') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: title,
    description: description,
    url: url,
    image: image || undefined,
    telephone: telephone || undefined,
    priceRange: priceRange || '$$',
    ...(address && {
      address: {
        '@type': 'PostalAddress',
        streetAddress: address.streetAddress,
        addressLocality: address.addressLocality,
        postalCode: address.postalCode,
        addressCountry: address.addressCountry || 'CZ',
      },
    }),
    ...(geo && {
      geo: {
        '@type': 'GeoCoordinates',
        latitude: geo.latitude,
        longitude: geo.longitude,
      },
    }),
    ...(openingHours && {
      openingHoursSpecification: openingHours.map((hours) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: hours.split(' ')[0],
        opens: hours.split(' ')[1]?.split('-')[0],
        closes: hours.split(' ')[1]?.split('-')[1],
      })),
    }),
  };
} else if (type === 'Article') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: description,
    url: url,
    image: image || undefined,
    datePublished: publishedAt || undefined,
    author: authorName ? { '@type': 'Person', name: authorName } : undefined,
  };
} else {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    description: description,
    url: url,
  };
}

const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
{faqSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
)}
