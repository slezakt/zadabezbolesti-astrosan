---
import { getAnalyticsConfig, requiresConsent } from '../analytics/config';
const show = requiresConsent(getAnalyticsConfig().activeProvider);
---
{show && <aside id="privacy-consent-banner" class="fixed bottom-6 left-6 right-6 max-w-xl mx-auto bg-slate-900 border border-white/10 rounded-2xl p-5 shadow-2xl z-50 hidden" aria-label="Nastavení soukromí">
  <p class="text-sm text-slate-300 mb-4">Můžeme použít analytické cookies pro měření a zlepšování webu?</p>
  <div class="flex gap-2 justify-end"><button id="consent-decline" class="px-4 py-2 text-sm border border-white/20 rounded-xl">Odmítnout</button><button id="consent-accept" class="px-4 py-2 text-sm bg-indigo-500 text-white rounded-xl">Přijmout</button></div>
</aside>}
{show && <script>
  import { hasUserDecided, setAnalyticsConsent } from '../analytics/consent';
  const banner = document.getElementById('privacy-consent-banner');
  if (banner && !hasUserDecided()) banner.classList.remove('hidden');
  document.getElementById('consent-accept')?.addEventListener('click', () => { setAnalyticsConsent(true); banner?.classList.add('hidden'); });
  document.getElementById('consent-decline')?.addEventListener('click', () => { setAnalyticsConsent(false); banner?.classList.add('hidden'); });
</script>}
