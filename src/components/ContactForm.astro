---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim();
if (import.meta.env.PROD && !accessKey) {
  console.warn('[ContactForm] PUBLIC_WEB3FORMS_ACCESS_KEY is not set. Form submissions will not be delivered.');
}
---

<div class="bg-slate-900/60 border border-white/10 rounded-2xl p-8 max-w-xl mx-auto">
  <div id="contact-success" class="hidden bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 p-4 rounded-xl mb-6 text-sm" role="status">
    ✓ Děkujeme! Zpráva byla úspěšně odeslána.
  </div>
  <div id="contact-error" class="hidden bg-red-500/15 border border-red-500/30 text-red-400 p-4 rounded-xl mb-6 text-sm" role="alert">
    Odeslání se nepodařilo. Zkuste to znovu nebo použijte přímý kontakt.
  </div>

  <form id="contact-form" class="space-y-5" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value={accessKey || ''} />
    <input type="hidden" name="subject" value="Nová zpráva z webu" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <div>
      <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Jméno a příjmení *</label>
      <input type="text" id="contact-name" name="name" required minlength="2" autocomplete="name" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500" />
    </div>
    <div>
      <label for="contact-email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">E-mail *</label>
      <input type="email" id="contact-email" name="email" required autocomplete="email" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500" />
    </div>
    <div>
      <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Zpráva *</label>
      <textarea id="contact-message" name="message" required minlength="10" rows="5" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500"></textarea>
    </div>
    <button id="contact-submit" type="submit" disabled={!accessKey} class="w-full bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold py-3.5 px-6 rounded-xl disabled:opacity-50">
      {accessKey ? 'Odeslat zprávu' : 'Formulář není nakonfigurovaný'}
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const success = document.getElementById('contact-success');
  const error = document.getElementById('contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submit) return;
    submit.disabled = true;
    submit.textContent = 'Odesílám…';
    success?.classList.add('hidden');
    error?.classList.add('hidden');
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const result = await response.json() as { success?: boolean };
      if (!response.ok || result.success !== true) throw new Error('Web3Forms rejected the request.');
      form.reset();
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      window.dispatchEvent(new CustomEvent('starter-contact-success'));
    } catch (cause) {
      console.error('[contact form]', cause);
      error?.classList.remove('hidden');
      submit.disabled = false;
      submit.textContent = 'Odeslat zprávu';
    }
  });
</script>
