---
interface Props {
  id: string;
  title?: string;
}

const { id, title = 'Informace' } = Astro.props;
---

<div
  class="relative z-50"
  x-data="{ open: false }"
  @open-modal.window={`if ($event.detail.id === '${id}') open = true`}
  @keydown.escape.window="open = false"
>
  <div
    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50"
    x-show="open"
    x-transition.opacity
    @click="open = false"
    style="display: none;"
  ></div>

  <div
    class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11/12 max-w-lg bg-slate-900 border border-white/10 rounded-2xl shadow-2xl z-50 overflow-hidden"
    x-show="open"
    x-transition
    style="display: none;"
    role="dialog"
    aria-modal="true"
  >
    <header class="flex justify-between items-center px-6 py-4 border-b border-white/10">
      <h3 class="text-white font-heading text-xl font-bold">{title}</h3>
      <button @click="open = false" class="text-slate-400 hover:text-white text-xl bg-transparent border-none cursor-pointer" aria-label="Zavřít">✕</button>
    </header>
    <div class="p-6 text-slate-300">
      <slot />
    </div>
  </div>
</div>
